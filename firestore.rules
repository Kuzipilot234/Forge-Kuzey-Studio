rules_version = '2';
// Firestore security rules for Forge Kuzey Studio.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Each signed-in user with a verified email can only read, add and delete their own storyboards.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/storyboards/{storyboardId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.scenes is list
        && request.resource.data.scenes.size() <= 12;
    }
  }
}
